{
  "name": "oklent-business-api",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "OKLENT BUSINESS accounting engine API (Fastify + PostgreSQL). https://oklent.net/",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/seed-demo.js",
    "test": "node src/smoke-test.js",
    "test:ui": "node ../tests/ui-smoke.mjs",
    "test:unit": "node ../tests/security-unit.mjs",
    "test:ai": "node ../tests/ai-security.mjs",
    "test:shop": "node ../tests/shop-smoke.mjs",
    "test:images": "node ../tests/products-image-smoke.mjs",
    "test:all": "bash ../scripts/test-all.sh",
    "test:sql": "psql -X -v ON_ERROR_STOP=1 -f ../tests/db_rules_test.sql && psql -X -v ON_ERROR_STOP=1 -f ../tests/db_rules_extra.sql",
    "test:migrate": "bash ../tests/migrate-test.sh",
    "config-check": "node src/config-check-cli.js ../.env"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.5",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.0.0",
    "marked": "^15.0.0",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}

