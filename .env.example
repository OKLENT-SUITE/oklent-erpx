# Copy to .env.  BEFORE production:  chmod 600 .env && node api/src/config-check-cli.js .env   (refuses weak/default/reused secrets) — see docs/DEPLOYMENT.md.
# Copy to .env. For a local demo leave NODE_ENV=development (default passwords are accepted).
# For anything real set NODE_ENV=production: the API then REFUSES to start unless JWT_SECRET is >= 32 random characters
# and APP_DB_PASSWORD is >= 12 characters, neither a default nor containing "change-me".
OWNER_DB_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
ADMIN_PASSWORD=change-me-admin
JWT_SECRET=change-me-long-random-string
NODE_ENV=development

# Local read-only assistant; enabled by default. Set false to disable it.
AI_LOCAL_ENABLED=true
AI_MAX_INPUT_CHARS=6000

# ---- Multi-tenant (v1.5.0): one PostgreSQL schema per company. Default 0 = single company exactly as before. See docs/MULTITENANT.md ----
MULTI_TENANT=0
# Sub-domain per company (acme.erp.example.com): set the base domain. Leave empty to use the sign-in "company code" or /t/<company>/ paths.
TENANT_BASE_DOMAIN=
# 1 = refuse requests that do not name a company (no fallback to the default company)
TENANT_REQUIRE_EXPLICIT=
DEFAULT_TENANT_SLUG=default
# Optional separate key for the 2FA secrets at rest (else derived from JWT_SECRET). Changing it invalidates enrolled authenticators.
TOTP_ENC_KEY=
# 1 enforces the password policy (12+ chars...) outside production too
PASSWORD_POLICY=
# ZATCA phase 2 network calls stay OFF until you have a sandbox account (docs/ZATCA_PHASE2.md)
ZATCA_ENABLED=0
ZATCA_ENV=sandbox
