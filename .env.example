# Copy to .env. For a local demo leave NODE_ENV=development (default passwords are accepted).
# For anything real set NODE_ENV=production: the API then REFUSES to start unless JWT_SECRET is >= 32 random characters
# and APP_DB_PASSWORD is >= 12 characters, neither a default nor containing "change-me".
OWNER_DB_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
ADMIN_PASSWORD=change-me-admin
JWT_SECRET=change-me-long-random-string
NODE_ENV=development
